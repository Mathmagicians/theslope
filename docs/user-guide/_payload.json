fødselsdato"," - Vigtigt! Billetprisen beregnes ud fra alder:\n",[81,82,83,89,95],"ul",{},[68,84,85,88],{},[23,86,87],{},"Baby"," (0-1 år) - babypris",[68,90,91,94],{},[23,92,93],{},"Barn"," (2-11 år) - reduceret pris",[68,96,97,100],{},[23,98,99],{},"Voksen"," (12+ år) - fuld pris",[18,102,103],{},[14,104,105,108,109,112],{},[23,106,107],{},"Vigtigt for forældre:"," Tjek at dine børn er registreret i Heynabo ",[23,110,111],{},"med korrekt fødselsdato",". Uden fødselsdato betaler du voksenpris for alle børn! Tilføj eller ret børnenes fødselsdato i Heynabo - så synkroniseres det automatisk til Skrånerappen.",[114,115,117],"h3",{"id":116},"sådan-tjekker-du-dine-børns-billettype","Sådan tjekker du dine børns billettype",[65,119,120,129,138,141],{},[68,121,122,123],{},"Log ind på ",[28,124,128],{"href":125,"rel":126},"https:\u002F\u002Fwww.skraaningen.dk",[127],"nofollow","skraaningen.dk",[68,130,131,132,137],{},"Gå til ",[28,133,136],{"href":134,"rel":135},"https:\u002F\u002Fwww.skraaningen.dk\u002Fhousehold",[127],"Præferencer"," (fanen med hus-ikon)",[68,139,140],{},"Se listen over husstandens medlemmer",[68,142,143],{},"Hver person vises med deres billettype: Baby, Barn eller Voksen",[14,145,146,147,150,151,155],{},"Fylder et barn 12, skifter billettypen fra den første middag efter fødselsdagen - billetten får badgen ",[23,148,149],{},"Ny billetpris"," (",[152,153,154],"em",{},"Voksen fra 20\u002F10\u002F2026","), og i ugegitteret får barnet en Barn- og en Voksen-række den uge.",[14,157,158,159,161],{},"Står dit barn som ",[23,160,99],{}," selvom de er under 12 år? Så mangler fødselsdatoen i Heynabo. Ret det i Heynabo-appen, og det opdateres automatisk i Skrånerappen.",[50,163],{},[53,165,167],{"id":166},"hurtige-links","Hurtige links",[169,170,171,187],"table",{},[172,173,174],"thead",{},[175,176,177,181,184],"tr",{},[178,179,180],"th",{},"Sektion",[178,182,183],{},"Link",[178,185,186],{},"Beskrivelse",[188,189,190,206,223,240,248,259,273,287,301,315],"tbody",{},[1