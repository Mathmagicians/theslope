,300],{},"Administrer allergier og fødevareintoleranser for din husstand. Tilføj og opdater allergioplysninger for hver beboer",[175,302,303,306,312],{},[193,304,305],{},"› Økonomi",[193,307,308],{},[28,309,311],{"href":134,"rel":310},[127],"...\u002Feconomy",[193,313,314],{},"Se økonomisk oversigt for din husstand. Følg udgifter til fællesspisning og se fakturaer",[175,316,317,320,326],{},[193,318,319],{},"› Indstillinger",[193,321,322],{},[28,323,325],{"href":134,"rel":324},[127],"...\u002Fsettings",[193,327,328],{},"Administrer indstillinger for din husstand. Opdater beboeroplysninger og præferencer",[50,330],{},[53,332,334],{"id":333},"symboler-i-appen","Symboler i appen",[14,336,337],{},"I appen bruges følgende symboler til at vise spisningsform og status:",[169,339,340,354],{},[172,341,342],{},[175,343,344,348,351],{},[178,345,347],{"align":346},"center","Symbol",[178,349,350],{},"Navn",[178,352,353],{},"Betydning",[188,355,356,372,387,402,417,432,448,464,480,495,511,532],{},[175,357,358,365,369],{},[193,359,360],{"align":346},[361,362],"img",{"alt":363,"src":364},"Spisesal","https:\u002F\u002Fapi.iconify.design\u002Fhugeicons\u002Fdish-02.svg?height=20&color=%2322c55e",[193,366,367],{},[23,368,363],{},[193,370,371],{},"Spis i fællessalen til normal tid",[175,373,374,380,384],{},[193,375,376],{"align":346},[361,377],{"alt":378,"src":379},"Sen","https:\u002F\u002Fapi.iconify.design\u002Fheroicons\u002Fmoon.svg?height=20&color=%2322c55e",[193,381,382],{},[23,383,378],{},[193,385,386],{},"Spis i fællessalen til sen spisning",[175,388,389,395,399],{},[193,390,391],{"align":346},[361,392],{"alt":393,"src":394},"Takeaway","https:\u002F\u002Fapi.iconify.design\u002Fheroicons\u002Fshopping-bag.svg?height=20&color=%2322c55e",[193,396,397],{},[23,398,393],{},[193,400,401],{},"Hent mad og spis hjemme",[175,403,404,410,414],{},[193,405,406],{"align":346},[361,407],{"alt":408,"src":409},"Ingen","https:\u002F\u002Fapi.iconify.design\u002Fheroicons\u002Fx-circle.svg?height=2