[{"data":1,"prerenderedAt":899},["ShallowReactive",2],{"doc-\u002Fdocs\u002Fchef-guide":3},{"id":4,"title":5,"body":6,"description":16,"extension":892,"meta":893,"navigation":894,"path":895,"seo":896,"stem":897,"__hash__":898},"docs\u002Fdocs\u002Fchef-guide.md","Chefkokguide",{"type":7,"value":8,"toc":874},"minimark",[9,13,17,41,44,49,59,125,128,156,158,162,167,170,177,201,208,219,228,265,267,271,302,304,308,334,336,340,346,364,372,374,378,393,398,480,486,510,518,529,550,552,556,559,593,607,613,659,678,680,684,695,697,701,720,722,726,729,755,760,775,789,800,802,806,860,867,869],[10,11,5],"h1",{"id":12},"chefkokguide",[14,15,16],"p",{},"Denne guide er til dig, der er chefkok på et madhold.",[18,19,20],"blockquote",{},[14,21,22,26,27,32,33,32,37],{},[23,24,25],"strong",{},"Se også:"," ",[28,29,31],"a",{"href":30},"user-guide","Brugerguide"," | ",[28,34,36],{"href":35},"admin-guide","Administratorguide",[28,38,40],{"href":39},"features\u002Ffeatures","Systemoversigt",[42,43],"hr",{},[45,46,48],"h2",{"id":47},"dine-deadlines","Dine deadlines",[14,50,51,52,58],{},"Hver middag på ",[28,53,57],{"href":54,"rel":55},"https:\u002F\u002Fwww.skraaningen.dk\u002Fchef",[56],"nofollow","Chef-siden"," har tre chips, der tæller ned:",[60,61,62,78],"table",{},[63,64,65],"thead",{},[66,67,68,72,75],"tr",{},[69,70,71],"th",{},"Chip",[69,73,74],{},"Hvornår",[69,76,77],{},"Hvad skal du gøre?",[79,80,81,95,108],"tbody",{},[66,82,83,89,92],{},[84,85,86],"td",{},[23,87,88],{},"Menu",[84,90,91],{},"10 dage før middagen",[84,93,94],{},"Publicer din menu, så beboerne kan tilmelde sig",[66,96,97,102,105],{},[84,98,99],{},[23,100,101],{},"Framelding",[84,103,104],{},"Sæsonens frist - som regel 8 dage før",[84,106,107],{},"Tilmeldingen lukker. Herefter kan beboerne kun frigive billetter, og du kan regne med kuverterne i køkkenpanelet",[66,109,110,115,118],{},[84,111,112],{},[23,113,114],{},"Indkøb",[84,116,117],{},"Inden middagen",[84,119,120,121,124],{},"Skriv dine indkøb ind under ",[23,122,123],{},"Madbestilling"," - så er chippen grøn",[14,126,127],{},"Farven fortæller, hvor meget tid du har:",[129,130,131,138,144,150],"ul",{},[132,133,134,137],"li",{},[23,135,136],{},"Grøn"," - god tid",[132,139,140,143],{},[23,141,142],{},"Gul"," - under 72 timer",[132,145,146,149],{},[23,147,148],{},"Rød"," - under 24 timer",[132,151,152,155],{},[23,153,154],{},"Kranie"," - fristen er overskredet, men det er aldrig for sent",[42,157],{},[45,159,161],{"id":160},"trin-for-trin","Trin for trin",[163,164,166],"h3",{"id":165},"_1-bliv-chefkok","1. Bliv chefkok",[14,168,169],{},"Kokkehuen hopper ikke selv op på hovedet. Når du har aftalt med dit madhold — eller de andre chefkokke — at du tager tjansen en bestemt dag, melder du dig som chefkok i appen.",[14,171,172,173,176],{},"Mangler en middag en chefkok, lyser portrættet med et stort ",[23,174,175],{},"WANTED",", som en eftersøgt fra det vilde vesten. Du finder middagene to steder:",[129,178,179,191],{},[132,180,181,184,185,190],{},[23,182,183],{},"Middagskalenderen"," (",[28,186,189],{"href":187,"rel":188},"https:\u002F\u002Fwww.skraaningen.dk\u002Fdinner",[56],"dinner",") — viser alle middage",[132,192,193,184,196,200],{},[23,194,195],{},"Chefsiden",[28,197,199],{"href":54,"rel":198},[56],"chef",") — viser middagene for de madhold du selv er på",[14,202,203,204,207],{},"Klik ",[23,205,206],{},"Bliv chefkok",", bekræft — og dit ansigt pryder portrættet. Tjansen er din.",[14,209,210,215],{},[211,212],"img",{"alt":213,"src":214},"Middagen søger en chefkok","screenshots\u002Fchef\u002Frole-wanted.png",[216,217,218],"em",{},"WANTED — denne middag mangler en helt",[14,220,221,225],{},[211,222],{"alt":223,"src":224},"Du er chefkok","screenshots\u002Fchef\u002Frole-assigned.png",[216,226,227],{},"Tjansen er landet — nu er det dig der svinger grydeskeen",[18,229,230,244],{},[14,231,232,235,236,239,240,243],{},[23,233,234],{},"Fortrød du?"," Klik ",[23,237,238],{},"Ændre tjans"," på portrættet og vælg ",[23,241,242],{},"Meld afbud"," (to klik — vi vil være helt sikre). Tjansen bliver ledig igen, WANTED-skiltet popper op, og din menu nulstilles til den næste helt.",[14,245,246,249,250,252,253,260,261,264],{},[23,247,248],{},"Bytter I?"," Har en anden kok lovet at tage dagen, klikker vedkommende på ",[23,251,238],{}," ved dit portræt og vælger ",[23,254,255,256],{},"Overtag Chefkok-tjansen fra ",[257,258,259],"span",{},"dit navn",". Et ",[23,262,263],{},"Ja tak, jeg overtager Chefkok-tjansen"," senere skifter tjansen hænder — uden at WANTED-skiltet kommer frem.",[42,266],{},[163,268,270],{"id":269},"_2-planlæg-din-menu","2. Planlæg din menu",[272,273,274,281,284,291,297],"ol",{},[132,275,276,277],{},"Gå til ",[28,278,280],{"href":54,"rel":279},[56],"Chef",[132,282,283],{},"Klik på den middag du er chefkok for",[132,285,286,287,290],{},"Udfyld ",[23,288,289],{},"Menu titel"," (kort beskrivelse af retten)",[132,292,286,293,296],{},[23,294,295],{},"Beskrivelse"," (detaljer om maden)",[132,298,203,299],{},[23,300,301],{},"Gem",[42,303],{},[163,305,307],{"id":306},"_3-angiv-allergener","3. Angiv allergener",[272,309,310,320,325,331],{},[132,311,312,313,316,317],{},"Find linjen ",[23,314,315],{},"ALLERGENER"," under menuen og klik ",[23,318,319],{},"Rediger allergener",[132,321,322,323],{},"Marker hvilke allergener din menu indeholder (f.eks. gluten, nødder, mælk) og klik ",[23,324,301],{},[132,326,327,328],{},"Linjen viser nu hvor mange kuverter der er ramt, allergen for allergen - f.eks. ",[216,329,330],{},"3,5 kuv. | Mælk · 2,5",[132,332,333],{},"Tilpas menuen eller forbered alternativer til de ramte",[42,335],{},[163,337,339],{"id":338},"_4-publicer-til-heynabo","4. Publicer til Heynabo",[14,341,342,343],{},"⏰ ",[216,344,345],{},"Deadline: 10 dage før middagen",[272,347,348,358,361],{},[132,349,350,351,354,355],{},"Når din menu er klar, klik på ",[23,352,353],{},"Publicer"," - knappen skifter til ",[23,356,357],{},"Publiceret",[132,359,360],{},"Menuen overføres automatisk til Heynabo-kalenderen",[132,362,363],{},"Beboere kan nu se menuen i Heynabo-appen",[18,365,366],{},[14,367,368,371],{},[23,369,370],{},"Bemærk:"," Hvis du ændrer menuen senere, synkroniseres ændringerne automatisk til Heynabo.",[42,373],{},[163,375,377],{"id":376},"_5-tjek-tilmeldinger","5. Tjek tilmeldinger",[272,379,380,386],{},[132,381,382,383],{},"Gå til din middag på ",[28,384,280],{"href":54,"rel":385},[56],[132,387,388,389,392],{},"Se ",[23,390,391],{},"køkkenpanelet"," med overblik over tilmeldinger:",[14,394,395],{},[23,396,397],{},"Køkkenpanelet viser:",[60,399,400,410],{},[63,401,402],{},[66,403,404,407],{},[69,405,406],{},"Kategori",[69,408,409],{},"Indhold",[79,411,412,422,432,442,452,470],{},[66,413,414,419],{},[84,415,416],{},[23,417,418],{},"Total kuverter",[84,420,421],{},"Samlet antal portioner (voksen, barn, baby)",[66,423,424,429],{},[84,425,426],{},[23,427,428],{},"Takeaway",[84,430,431],{},"Antal og procentdel der henter mad",[66,433,434,439],{},[84,435,436],{},[23,437,438],{},"Spisesal",[84,440,441],{},"Antal og procentdel der spiser i salen",[66,443,444,449],{},[84,445,446],{},[23,447,448],{},"Spis sent",[84,450,451],{},"Antal og procentdel der kommer sent",[66,453,454,459],{},[84,455,456],{},[23,457,458],{},"Til salg",[84,460,461,462,465,466,469],{},"Frigivne billetter der kan købes. Står der naboer på ventelisten, får boksen et ",[23,463,464],{},"timeglas"," med ",[23,467,468],{},"VENTELISTE",": hvor mange kuverter ventelisten mangler, og hvilke billettyper de venter på",[66,471,472,477],{},[84,473,474],{},[23,475,476],{},"Allergier",[84,478,479],{},"Under hver kategori: hvor mange kuverter der har et af menuens allergener",[14,481,482,485],{},[23,483,484],{},"Klik på en kategori"," for at se detaljeret opdeling:",[129,487,488,491,494,497],{},[132,489,490],{},"Allergenerne øverst, med antal kuverter for hvert",[132,492,493],{},"Hvilke husstande der har tilmeldt sig, og billettyper per husstand (voksen\u002Fbarn\u002Fbaby)",[132,495,496],{},"Hvem der har et af menuens allergener - allergenets ikon står ud for navnet",[132,498,499,500,502,503,505,506,509],{},"Under ",[23,501,458],{},": billetterne til salg, og under ",[23,504,468],{}," én linje per husstand i den rækkefølge de skrev sig på - hver person med sin plads i billettypens kø, fx ",[216,507,508],{},"Emil (Barn #1)",". #1 i kø får den næste billet af sin type",[18,511,512],{},[14,513,514,517],{},[23,515,516],{},"Tip:"," Brug husstandsoversigten til at planlægge portionsstørrelser og allergihensyn.",[14,519,520,523,524,528],{},[23,521,522],{},"Står der naboer på ventelisten?"," Så viser middagen en boks med ",[211,525],{"alt":526,"src":527},"Venteliste","https:\u002F\u002Fapi.iconify.design\u002Fhugeicons\u002Fhourglass.svg?height=16&color=%23737373"," hvor mange der venter, og hvor mange portioner de mangler - og vokser køen, får du en mail. Kan du lave lidt ekstra:",[272,530,531,541,544],{},[132,532,203,533,536,537,540],{},[23,534,535],{},"Frigiv portioner"," i boksen - eller find den under ",[23,538,539],{},"tandhjulet"," i knaprækken",[132,542,543],{},"Skriv hvor mange portioner du kan frigive (feltet er udfyldt med det, ventelisten mangler)",[132,545,203,546,549],{},[23,547,548],{},"Frigiv"," - portionerne går til de første i køen, og de får en mail",[42,551],{},[163,553,555],{"id":554},"_6-madbestilling-og-budget","6. Madbestilling og budget",[14,557,558],{},"Når du har handlet, skriver du beløbet ind, så budgettet følger med:",[272,560,561,570,584,587],{},[132,562,312,563,566,567],{},[23,564,565],{},"MADBESTILLING"," på din middag og klik ",[23,568,569],{},"Rediger madbestilling",[132,571,572,573,576,577,580,581],{},"Skriv beløbet fra bonen, vælg ",[23,574,575],{},"Ex moms"," eller ",[23,578,579],{},"Inkl. moms"," som bonen er skrevet, og klik ",[23,582,583],{},"Tilføj",[132,585,586],{},"Linjen gemmes med det samme - med dato og dig som bestiller. Skraldespanden fjerner den igen",[132,588,203,589,592],{},[23,590,591],{},"Tilbage"," for at folde sektionen sammen",[14,594,595,596,599,600,603,604,606],{},"Over linjerne står hjælpetallene ",[23,597,598],{},"Rådighedsbeløb",", ",[23,601,602],{},"Brugt"," og ",[23,605,591],{}," - med et flueben når der er penge tilbage, og et udråbstegn når du er over. Laver dit madhold mad flere dage i træk, står holdets samlede saldo for de dage på sin egen linje.",[14,608,609,612],{},[23,610,611],{},"Budget","-sektionen nedenunder viser tre bokse:",[60,614,615,624],{},[63,616,617],{},[66,618,619,622],{},[69,620,621],{},"Boks",[69,623,409],{},[79,625,626,636,649],{},[66,627,628,633],{},[84,629,630],{},[23,631,632],{},"Indtægter",[84,634,635],{},"Alle betalte billetter - også dem der er frigivet efter fristen",[66,637,638,642],{},[84,639,640],{},[23,641,598],{},[84,643,644,645,603,647],{},"Indtægter minus køkkenbidrag: det du kan handle for. Med ",[23,646,602],{},[23,648,591],{},[66,650,651,656],{},[84,652,653],{},[23,654,655],{},"Køkkenbidrag",[84,657,658],{},"5 % af indtægterne, som går til køkkenet",[14,660,661,662,665,666,669,670,673,674,677],{},"Alle beløb står som ",[23,663,664],{},"ex \u002F inkl. moms",". Fold sektionen ud for ",[23,667,668],{},"Billetter"," (fordelt på voksen, barn og baby), ",[23,671,672],{},"Billetændringer"," siden menufristen - med ",[23,675,676],{},"Vis fuld historik"," - og holdets runde, hvis I laver mad flere dage i træk.",[42,679],{},[163,681,683],{"id":682},"_7-på-madlavningsdagen","7. På madlavningsdagen",[272,685,686,689],{},[132,687,688],{},"Tjek tilmeldinger en sidste gang for eventuelle ændringer",[132,690,691,692,694],{},"Afbud efter deadline står under ",[23,693,458],{}," - beboeren betaler, medmindre billetten bliver solgt",[42,696],{},[45,698,700],{"id":699},"kalender-og-agenda","Kalender og agenda",[14,702,703,704,707,708,711,712,715,716,719],{},"Øverst på ",[28,705,57],{"href":54,"rel":706},[56]," tæller ",[23,709,710],{},"Næste madlavning"," ned til din næste tjans. Under uret skifter du mellem ",[23,713,714],{},"Agenda"," (listen med chips) og ",[23,717,718],{},"Kalender"," (måneden med ringe i samme farver). Pilen til højre folder dem sammen, så middagen får hele skærmen.",[42,721],{},[45,723,725],{"id":724},"aflysning","Aflysning",[14,727,728],{},"Hvis middagen ikke kan afholdes:",[272,730,731,737,743],{},[132,732,733,734],{},"Gå til middagen på ",[28,735,280],{"href":54,"rel":736},[56],[132,738,739,740,742],{},"Klik på ",[23,741,539],{}," i knaprækken - farezonen folder sig ud",[132,744,203,745,748,749],{},[23,746,747],{},"Aflys middagen"," og bekræft med ",[23,750,751,752],{},"Tryk igen for at aflyse ",[257,753,754],{},"dato",[14,756,757],{},[23,758,759],{},"Hvad sker der:",[129,761,762,765,772],{},[132,763,764],{},"Middagen markeres som AFLYST — i kalenderen, på dagen og i husstandens oversigt",[132,766,767,768,771],{},"Billetterne bliver stående og viser ",[216,769,770],{},"aflyst","; ingen kan booke middagen, og den faktureres aldrig",[132,773,774],{},"Heynabo opdateres automatisk",[14,776,777,235,780,748,783,788],{},[23,778,779],{},"Fortryd aflysning:",[23,781,782],{},"Annuller aflysning",[23,784,785,786],{},"Tryk igen for at genåbne ",[257,787,754],{}," — billetterne er tilbage, som de var.",[18,790,791],{},[14,792,793,796,797,799],{},[23,794,795],{},"Skal du blot melde fra som chefkok?"," Brug ",[23,798,238],{}," ved kokkens portræt - så bliver middagen stående, og WANTED-skiltet finder den næste helt.",[42,801],{},[45,803,805],{"id":804},"dit-madhold","Dit madhold",[60,807,808,818],{},[63,809,810],{},[66,811,812,815],{},[69,813,814],{},"Rolle",[69,816,817],{},"Ansvar",[79,819,820,830,840,850],{},[66,821,822,827],{},[84,823,824],{},[23,825,826],{},"Chefkok",[84,828,829],{},"Planlægger menu, handler ind, leder køkkenet",[66,831,832,837],{},[84,833,834],{},[23,835,836],{},"Kok",[84,838,839],{},"Hjælper med tilberedning",[66,841,842,847],{},[84,843,844],{},[23,845,846],{},"Kokkespire",[84,848,849],{},"Lærer at lave mad, lettere opgaver",[66,851,852,857],{},[84,853,854],{},[23,855,856],{},"Joker",[84,858,859],{},"En plads uden navn i en periode - f.eks. en vikar for en kok på barsel. Admin sætter dem ind",[14,861,862,863,866],{},"Se dine holdmedlemmer på ",[28,864,280],{"href":54,"rel":865},[56],".",[42,868],{},[14,870,871],{},[216,872,873],{},"Sidst opdateret: Oktober 2026 (ventelisten og frigiv portioner, madbestilling og budget, overtag tjansen, allergener per kuvert, aflysning)",{"title":875,"searchDepth":876,"depth":876,"links":877},"",2,[878,879,889,890,891],{"id":47,"depth":876,"text":48},{"id":160,"depth":876,"text":161,"children":880},[881,883,884,885,886,887,888],{"id":165,"depth":882,"text":166},3,{"id":269,"depth":882,"text":270},{"id":306,"depth":882,"text":307},{"id":338,"depth":882,"text":339},{"id":376,"depth":882,"text":377},{"id":554,"depth":882,"text":555},{"id":682,"depth":882,"text":683},{"id":699,"depth":876,"text":700},{"id":724,"depth":876,"text":725},{"id":804,"depth":876,"text":805},"md",{},true,"\u002Fdocs\u002Fchef-guide",{"title":5,"description":16},"docs\u002Fchef-guide","zPkQVfycN4nI742CI0hlXfUO9qoypzI8QIKIm-XVZWw",1793056175263]