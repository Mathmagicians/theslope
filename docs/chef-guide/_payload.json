[{"data":1,"prerenderedAt":921},["ShallowReactive",2],{"doc-\u002Fdocs\u002Fchef-guide":3},{"id":4,"title":5,"body":6,"description":16,"extension":914,"meta":915,"navigation":916,"path":917,"seo":918,"stem":919,"__hash__":920},"docs\u002Fdocs\u002Fchef-guide.md","Chefkokguide",{"type":7,"value":8,"toc":896},"minimark",[9,13,17,41,44,49,59,125,128,156,158,162,167,170,177,221,228,239,248,285,287,291,322,324,328,354,356,360,366,384,392,394,398,413,418,500,506,530,538,549,570,572,576,579,612,629,635,681,704,706,710,721,723,727,746,748,752,755,781,786,801,815,826,828,832,883,889,891],[10,11,5],"h1",{"id":12},"chefkokguide",[14,15,16],"p",{},"Denne guide er til dig, der er chefkok på et madhold.",[18,19,20],"blockquote",{},[14,21,22,26,27,32,33,32,37],{},[23,24,25],"strong",{},"Se også:"," ",[28,29,31],"a",{"href":30},"user-guide","Brugerguide"," | ",[28,34,36],{"href":35},"admin-guide","Administratorguide",[28,38,40],{"href":39},"features\u002Ffeatures","Systemoversigt",[42,43],"hr",{},[45,46,48],"h2",{"id":47},"dine-deadlines","Dine deadlines",[14,50,51,52,58],{},"Hver middag på ",[28,53,57],{"href":54,"rel":55},"https:\u002F\u002Fwww.skraaningen.dk\u002Fchef",[56],"nofollow","Chef-siden"," har tre chips, der tæller ned:",[60,61,62,78],"table",{},[63,64,65],"thead",{},[66,67,68,72,75],"tr",{},[69,70,71],"th",{},"Chip",[69,73,74],{},"Hvornår",[69,76,77],{},"Hvad skal du gøre?",[79,80,81,95,108],"tbody",{},[66,82,83,89,92],{},[84,85,86],"td",{},[23,87,88],{},"Menu",[84,90,91],{},"10 dage før middagen",[84,93,94],{},"Publicer din menu, så beboerne kan tilmelde sig",[66,96,97,102,105],{},[84,98,99],{},[23,100,101],{},"Framelding",[84,103,104],{},"Sæsonens frist - som regel 8 dage før",[84,106,107],{},"Tilmeldingen lukker. Herefter kan beboerne kun frigive billetter, og du kan regne med kuverterne i køkkenpanelet",[66,109,110,115,118],{},[84,111,112],{},[23,113,114],{},"Indkøb",[84,116,117],{},"Inden middagen",[84,119,120,121,124],{},"Skriv dine indkøb ind under ",[23,122,123],{},"Madbestilling"," - så er chippen grøn",[14,126,127],{},"Farven fortæller, hvor meget tid du har:",[129,130,131,138,144,150],"ul",{},[132,133,134,137],"li",{},[23,135,136],{},"Grøn"," - god tid",[132,139,140,143],{},[23,141,142],{},"Gul"," - under 72 timer",[132,145,146,149],{},[23,147,148],{},"Rød"," - under 24 timer",[132,151,152,155],{},[23,153,154],{},"Kranie"," - fristen er overskredet, men det er aldrig for sent",[42,157],{},[45,159,161],{"id":160},"trin-for-trin","Trin for trin",[163,164,166],"h3",{"id":165},"_1-bliv-chefkok","1. Bliv chefkok",[14,168,169],{},"Kokkehuen hopper ikke selv op på hovedet. Når du har aftalt med dit madhold — eller de andre chefkokke — at du tager tjansen en bestemt dag, melder du dig som chefkok i appen.",[14,171,172,173,176],{},"Mangler en middag en chefkok, lyser portrættet med et stort ",[23,174,175],{},"WANTED",", som en eftersøgt fra det vilde vesten. Du finder middagene to steder:",[129,178,179,191],{},[132,180,181,184,185,190],{},[23,182,183],{},"Middagskalenderen"," (",[28,186,189],{"href":187,"rel":188},"https:\u002F\u002Fwww.skraaningen.dk\u002Fdinner",[56],"dinner",") — viser alle middage",[132,192,193,184,196,200,201,204,205,208,209,212,213,216,217,220],{},[23,194,195],{},"Chefsiden",[28,197,199],{"href":54,"rel":198},[56],"chef",") — viser middage for alle madholdene: dit eget hold i farver, andres hold som grå ringe (",[23,202,203],{},"Andet madholds fællesspisning"," i Forklaring). Klik på en grå ring, og du kigger med hos det andet madhold - fanen siger ",[23,206,207],{},"Ikke dit hold",", menuen kan du ikke røre, men du kan melde dig som ",[23,210,211],{},"Chefkok",", ",[23,214,215],{},"Kok"," eller ",[23,218,219],{},"Kokkespire",". Er du ikke på et madhold, lander du hos det madhold, der laver mad næste gang",[14,222,223,224,227],{},"Klik ",[23,225,226],{},"Bliv chefkok",", bekræft — og dit ansigt pryder portrættet. Tjansen er din.",[14,229,230,235],{},[231,232],"img",{"alt":233,"src":234},"Middagen søger en chefkok","screenshots\u002Fchef\u002Frole-wanted.png",[236,237,238],"em",{},"WANTED — denne middag mangler en helt",[14,240,241,245],{},[231,242],{"alt":243,"src":244},"Du er chefkok","screenshots\u002Fchef\u002Frole-assigned.png",[236,246,247],{},"Tjansen er landet — nu er det dig der svinger grydeskeen",[18,249,250,264],{},[14,251,252,255,256,259,260,263],{},[23,253,254],{},"Fortrød du?"," Klik ",[23,257,258],{},"Rediger chefkokketjans"," på portrættet og vælg ",[23,261,262],{},"Meld afbud"," (to klik — vi vil være helt sikre). Tjansen bliver ledig igen, WANTED-skiltet popper op, og din menu nulstilles til den næste helt.",[14,265,266,269,270,272,273,280,281,284],{},[23,267,268],{},"Bytter I?"," Har en anden kok lovet at tage dagen, klikker vedkommende på ",[23,271,258],{}," ved dit portræt og vælger ",[23,274,275,276],{},"Overtag Chefkok-tjansen fra ",[277,278,279],"span",{},"dit navn",". Et ",[23,282,283],{},"Ja tak, jeg overtager Chefkok-tjansen"," senere skifter tjansen hænder — uden at WANTED-skiltet kommer frem.",[42,286],{},[163,288,290],{"id":289},"_2-planlæg-din-menu","2. Planlæg din menu",[292,293,294,301,304,311,317],"ol",{},[132,295,296,297],{},"Gå til ",[28,298,300],{"href":54,"rel":299},[56],"Chef",[132,302,303],{},"Klik på den middag du er chefkok for",[132,305,306,307,310],{},"Udfyld ",[23,308,309],{},"Menu titel"," (kort beskrivelse af retten)",[132,312,306,313,316],{},[23,314,315],{},"Beskrivelse"," (detaljer om maden)",[132,318,223,319],{},[23,320,321],{},"Gem",[42,323],{},[163,325,327],{"id":326},"_3-angiv-allergener","3. Angiv allergener",[292,329,330,340,345,351],{},[132,331,332,333,336,337],{},"Find linjen ",[23,334,335],{},"ALLERGENER"," under menuen og klik ",[23,338,339],{},"Rediger allergener",[132,341,342,343],{},"Marker hvilke allergener din menu indeholder (f.eks. gluten, nødder, mælk) og klik ",[23,344,321],{},[132,346,347,348],{},"Linjen viser nu hvor mange kuverter der er ramt, allergen for allergen - f.eks. ",[236,349,350],{},"3,5 kuv. | Mælk · 2,5",[132,352,353],{},"Tilpas menuen eller forbered alternativer til de ramte",[42,355],{},[163,357,359],{"id":358},"_4-publicer-til-heynabo","4. Publicer til Heynabo",[14,361,362,363],{},"⏰ ",[236,364,365],{},"Deadline: 10 dage før middagen",[292,367,368,378,381],{},[132,369,370,371,374,375],{},"Når din menu er klar, klik på ",[23,372,373],{},"Publicer"," - knappen skifter til ",[23,376,377],{},"Publiceret",[132,379,380],{},"Menuen overføres automatisk til Heynabo-kalenderen",[132,382,383],{},"Beboere kan nu se menuen i Heynabo-appen",[18,385,386],{},[14,387,388,391],{},[23,389,390],{},"Bemærk:"," Hvis du ændrer menuen senere, synkroniseres ændringerne automatisk til Heynabo.",[42,393],{},[163,395,397],{"id":396},"_5-tjek-tilmeldinger","5. Tjek tilmeldinger",[292,399,400,406],{},[132,401,402,403],{},"Gå til din middag på ",[28,404,300],{"href":54,"rel":405},[56],[132,407,408,409,412],{},"Se ",[23,410,411],{},"køkkenpanelet"," med overblik over tilmeldinger:",[14,414,415],{},[23,416,417],{},"Køkkenpanelet viser:",[60,419,420,430],{},[63,421,422],{},[66,423,424,427],{},[69,425,426],{},"Kategori",[69,428,429],{},"Indhold",[79,431,432,442,452,462,472,490],{},[66,433,434,439],{},[84,435,436],{},[23,437,438],{},"Total kuverter",[84,440,441],{},"Samlet antal portioner (voksen, barn, baby)",[66,443,444,449],{},[84,445,446],{},[23,447,448],{},"Takeaway",[84,450,451],{},"Antal og procentdel der henter mad",[66,453,454,459],{},[84,455,456],{},[23,457,458],{},"Spisesal",[84,460,461],{},"Antal og procentdel der spiser i salen",[66,463,464,469],{},[84,465,466],{},[23,467,468],{},"Sen",[84,470,471],{},"Antal og procentdel der kommer sent",[66,473,474,479],{},[84,475,476],{},[23,477,478],{},"Til salg",[84,480,481,482,485,486,489],{},"Frigivne billetter der kan købes. Står der naboer på ventelisten, får boksen et ",[23,483,484],{},"timeglas"," med ",[23,487,488],{},"VENTELISTE",": hvor mange kuverter ventelisten mangler, og hvilke billettyper de venter på",[66,491,492,497],{},[84,493,494],{},[23,495,496],{},"Allergier",[84,498,499],{},"Under hver kategori: hvor mange kuverter der har et af menuens allergener",[14,501,502,505],{},[23,503,504],{},"Klik på en kategori"," for at se detaljeret opdeling:",[129,507,508,511,514,517],{},[132,509,510],{},"Allergenerne øverst, med antal kuverter for hvert",[132,512,513],{},"Hvilke husstande der har tilmeldt sig, og billettyper per husstand (voksen\u002Fbarn\u002Fbaby)",[132,515,516],{},"Hvem der har et af menuens allergener - allergenets ikon står ud for navnet",[132,518,519,520,522,523,525,526,529],{},"Under ",[23,521,478],{},": billetterne til salg, og under ",[23,524,488],{}," én linje per husstand i den rækkefølge de skrev sig på - hver person med sin plads i billettypens kø, fx ",[236,527,528],{},"Emil (Barn #1)",". #1 i kø får den næste billet af sin type",[18,531,532],{},[14,533,534,537],{},[23,535,536],{},"Tip:"," Brug husstandsoversigten til at planlægge portionsstørrelser og allergihensyn.",[14,539,540,543,544,548],{},[23,541,542],{},"Står der naboer på ventelisten?"," Så viser middagen en boks med ",[231,545],{"alt":546,"src":547},"Venteliste","https:\u002F\u002Fapi.iconify.design\u002Fhugeicons\u002Fhourglass.svg?height=16&color=%23737373"," hvor mange der venter, og hvor mange portioner de mangler - og vokser køen, får du en mail. Kan du lave lidt ekstra:",[292,550,551,561,564],{},[132,552,223,553,556,557,560],{},[23,554,555],{},"Frigiv portioner"," i boksen - eller find den under ",[23,558,559],{},"tandhjulet"," i knaprækken",[132,562,563],{},"Skriv hvor mange portioner du kan frigive (feltet er udfyldt med det, ventelisten mangler)",[132,565,223,566,569],{},[23,567,568],{},"Frigiv"," - portionerne går til de første i køen, og de får en mail om, at billetten er deres",[42,571],{},[163,573,575],{"id":574},"_6-madbestilling-og-budget","6. Madbestilling og budget",[14,577,578],{},"Når du har handlet, skriver du beløbet ind, så budgettet følger med:",[292,580,581,590,603,606],{},[132,582,332,583,586,587],{},[23,584,585],{},"MADBESTILLING"," på din middag og klik ",[23,588,589],{},"Rediger madbestilling",[132,591,592,593,216,596,599,600],{},"Skriv beløbet fra bonen, vælg ",[23,594,595],{},"Ex moms",[23,597,598],{},"Inkl. moms"," som bonen er skrevet, og klik ",[23,601,602],{},"Tilføj",[132,604,605],{},"Linjen gemmes med det samme - med dato og dig som bestiller. Skraldespanden fjerner den igen",[132,607,223,608,611],{},[23,609,610],{},"Tilbage"," for at folde sektionen sammen",[14,613,614,615,212,618,621,622,624,625,628],{},"Over linjerne står hjælpetallene ",[23,616,617],{},"Rådighedsbeløb",[23,619,620],{},"Brugt"," og ",[23,623,610],{}," - med et flueben når der er penge tilbage, og et udråbstegn når du er over. Laver dit madhold mad flere dage i træk, står holdets samlede saldo for de dage under overskriften ",[23,626,627],{},"Madhold 2, periode 03\u002F11-10\u002F11",".",[14,630,631,634],{},[23,632,633],{},"Budget","-sektionen nedenunder viser tre bokse:",[60,636,637,646],{},[63,638,639],{},[66,640,641,644],{},[69,642,643],{},"Boks",[69,645,429],{},[79,647,648,658,671],{},[66,649,650,655],{},[84,651,652],{},[23,653,654],{},"Indtægter",[84,656,657],{},"Alle betalte billetter - også dem der er frigivet efter fristen",[66,659,660,664],{},[84,661,662],{},[23,663,617],{},[84,665,666,667,621,669],{},"Indtægter minus køkkenbidrag: det du kan handle for. Med ",[23,668,620],{},[23,670,610],{},[66,672,673,678],{},[84,674,675],{},[23,676,677],{},"Køkkenbidrag",[84,679,680],{},"5 % af indtægterne, som går til køkkenet",[14,682,683,684,687,688,691,692,695,696,699,700,703],{},"Alle beløb står som ",[23,685,686],{},"ex \u002F inkl. moms",". Fold sektionen ud for ",[23,689,690],{},"Billetter"," (fordelt på voksen, barn og baby), ",[23,693,694],{},"Billetændringer"," siden ",[23,697,698],{},"Framelding lukker"," - med ",[23,701,702],{},"Vis fuld historik"," for dem før - og holdets runde, hvis I laver mad flere dage i træk.",[42,705],{},[163,707,709],{"id":708},"_7-på-madlavningsdagen","7. På madlavningsdagen",[292,711,712,715],{},[132,713,714],{},"Tjek tilmeldinger en sidste gang for eventuelle ændringer",[132,716,717,718,720],{},"Afbud efter deadline står under ",[23,719,478],{}," - beboeren betaler, medmindre billetten bliver solgt",[42,722],{},[45,724,726],{"id":725},"kalender-og-agenda","Kalender og agenda",[14,728,729,730,733,734,737,738,741,742,745],{},"Øverst på ",[28,731,57],{"href":54,"rel":732},[56]," tæller ",[23,735,736],{},"Næste madlavning"," ned til din næste tjans. Under uret skifter du mellem ",[23,739,740],{},"Agenda"," (listen med chips) og ",[23,743,744],{},"Kalender"," (måneden med ringe i samme farver). Pilen til højre folder dem sammen, så middagen får hele skærmen.",[42,747],{},[45,749,751],{"id":750},"aflysning","Aflysning",[14,753,754],{},"Hvis middagen ikke kan afholdes:",[292,756,757,763,769],{},[132,758,759,760],{},"Gå til middagen på ",[28,761,300],{"href":54,"rel":762},[56],[132,764,765,766,768],{},"Klik på ",[23,767,559],{}," i knaprækken - farezonen folder sig ud",[132,770,223,771,774,775],{},[23,772,773],{},"Aflys middagen"," og bekræft med ",[23,776,777,778],{},"Tryk igen for at aflyse ",[277,779,780],{},"dato",[14,782,783],{},[23,784,785],{},"Hvad sker der:",[129,787,788,791,798],{},[132,789,790],{},"Middagen markeres som AFLYST — i kalenderen, på dagen og i husstandens oversigt",[132,792,793,794,797],{},"Billetterne bliver stående og viser ",[236,795,796],{},"aflyst","; ingen kan booke middagen, og den faktureres aldrig",[132,799,800],{},"Heynabo opdateres automatisk",[14,802,803,255,806,774,809,814],{},[23,804,805],{},"Fortryd aflysning:",[23,807,808],{},"Annuller aflysning",[23,810,811,812],{},"Tryk igen for at genåbne ",[277,813,780],{}," — billetterne er tilbage, som de var.",[18,816,817],{},[14,818,819,822,823,825],{},[23,820,821],{},"Skal du blot melde fra som chefkok?"," Brug ",[23,824,258],{}," ved kokkens portræt - så bliver middagen stående, og WANTED-skiltet finder den næste helt.",[42,827],{},[45,829,831],{"id":830},"dit-madhold","Dit madhold",[60,833,834,844],{},[63,835,836],{},[66,837,838,841],{},[69,839,840],{},"Rolle",[69,842,843],{},"Ansvar",[79,845,846,855,864,873],{},[66,847,848,852],{},[84,849,850],{},[23,851,211],{},[84,853,854],{},"Planlægger menu, handler ind, leder køkkenet",[66,856,857,861],{},[84,858,859],{},[23,860,215],{},[84,862,863],{},"Hjælper med tilberedning",[66,865,866,870],{},[84,867,868],{},[23,869,219],{},[84,871,872],{},"Lærer at lave mad, lettere opgaver",[66,874,875,880],{},[84,876,877],{},[23,878,879],{},"Joker",[84,881,882],{},"En plads uden navn i en periode - f.eks. en vikar for en kok på barsel. Admin sætter dem ind",[14,884,885,886,628],{},"Se dine holdmedlemmer på ",[28,887,300],{"href":54,"rel":888},[56],[42,890],{},[14,892,893],{},[236,894,895],{},"Sidst opdateret: November 2026 (mail ved frigivne portioner, ventelisten og frigiv portioner, madbestilling og budget, overtag tjansen, allergener per kuvert, aflysning, kig på de andre madhold, Rediger chefkokketjans)",{"title":897,"searchDepth":898,"depth":898,"links":899},"",2,[900,901,911,912,913],{"id":47,"depth":898,"text":48},{"id":160,"depth":898,"text":161,"children":902},[903,905,906,907,908,909,910],{"id":165,"depth":904,"text":166},3,{"id":289,"depth":904,"text":290},{"id":326,"depth":904,"text":327},{"id":358,"depth":904,"text":359},{"id":396,"depth":904,"text":397},{"id":574,"depth":904,"text":575},{"id":708,"depth":904,"text":709},{"id":725,"depth":898,"text":726},{"id":750,"depth":898,"text":751},{"id":830,"depth":898,"text":831},"md",{},true,"\u002Fdocs\u002Fchef-guide",{"title":5,"description":16},"docs\u002Fchef-guide","CCvZ3am1-S_oZ--G60LWJOpfhx6XyDpMvbgI9ZvOEH8",1794260153145]