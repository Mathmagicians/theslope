n.png",[14,507,508],{},[18,509,510],{},"Hvad sker der ved aktivering:",[424,512,513,521,524,527],{},[409,514,515,516,520],{},"Sæsonen bliver synlig for alle (",[461,517],{"alt":518,"src":519},"Aktiv","https:\u002F\u002Fapi.iconify.design\u002Fmdi\u002Fcircle.svg?height=16&color=%2322c55e"," status)",[409,522,523],{},"Tilmeldinger oprettes ud fra beboernes præferencer",[409,525,526],{},"Kun middage inden for 60 dage bliver booket",[409,528,529],{},"Afmeldinger respekteres (systemet genskaber ikke afmeldte billetter)",[401,531,533],{"id":532},"sådan-redigerer-du-en-sæson","Sådan redigerer du en sæson",[14,535,536],{},"Datoer, madlavningsdage, ferier og priser kan rettes - også på den aktive sæson:",[406,538,539,545,548,557],{},[409,540,541,542],{},"Vælg sæsonen i sæsonvælgeren og klik på ",[18,543,544],{},"blyanten",[409,546,547],{},"Ret datoer, ugedage eller ferier",[409,549,417,550,552,553],{},[18,551,454],{}," - kvitteringen fortæller hvad der skete, f.eks. ",[554,555,556],"em",{},"\"Sæson opdateret — 3 datoer tilføjet, 1 fjernet. Forudbestillinger er opdateret. Husk at tildele madhold til nye datoer.\"",[409,558,411,559,562],{},[32,560,165],{"href":289,"rel":561},[264]," og giv de nye datoer et hold",[14,564,565,566,569],{},"Skal sæsonen af igen, finder du ",[18,567,568],{},"Deaktiver Sæson"," i samme redigeringsvisning.",[401,571,573],{"id":572},"sæsonstatusikoner","Sæsonstatusikoner",[14,575,576],{},"Sæsonvælgeren viser sæsonerne i rækkefølgen aktiv, inaktiv, fremtidig, arkiveret og vælger den sæson, der er i gang.",[65,578,579,593],{},[68,580,581],{},[71,582,583,587,590],{},[74,584,586],{"align":585},"center","Ikon",[74,588,589],{},"Status",[74,591,592],{},"Betydning",[84,594,595,607,619,631],{},[71,596,597,602,604],{},[89,598,599],{"align":585},[461,600],{"alt":518,"src":601},"https:\u002F\u002Fapi.iconify.design\u002Fmdi\u002Fcircle.svg?height=20&color=%2322c55e",[89,603,518],{},[89,605,606],{},"Synlig for brugere, tilmeldinger aktive",[71,608,609,614,616],{},[89,610,611],{"align":585},[461,612],{"alt":492,"src":613},"https:\u002F\u002Fapi.iconify.design\u002Fmdi\u002Fcircle.svg?height=20&color=%23facc15",[89,615,492],{},[89,617,618],{},"Datoerne er nu, men sæsonen er ikke aktiveret",[71,620,621,626,628],{},[89,622,623],{"align":585},[461,624],{"alt":487,"src":625},"https:\u002F\u002Fapi.iconify.design\u002Fmdi\u002Fsprout.svg?height=20&color=%2322c55e",[89,627,487],{},[89,629,630],{},"Kan aktiveres, datoer er i fremtiden",[71,632,633,639,641],{},[89,634,635],{"align":585},[461,636],{"alt":637,"src":638},"Arkiveret","https:\u002F\u002Fapi.iconify.design\u002Fmdi\u002Fcircle.svg?height=20&color=%236b7280",[89,640,637],{},[89,642,643],{},"Afsluttet, kan ikke genaktiveres",[14,645,646],{},[461,647],{"alt":648,"src":649},"Sæsonvælger","screenshots\u002Fadmin\u002Fseason-selector-dropdown-status-indicators.png",[50,651],{},[53,653,165],{"id":654},"madhold",[14,656,657],{},"Fanen viser sæsonens hold i en tabel med deres madlavningsdage. Uden valg står alle holds kalender ved siden af; klik på en række, og holdets detaljer tager pladsen.",[401,659,661],{"id":660},"sådan-opretter-du-madhold","Sådan opretter du madhold",[406,663,664,670,676,679],{},[409,665,411,666,669],{},[32,667,165],{"href":289,"rel":668},[264]," og vælg sæsonen i dropdown-menuen",[409,671,417,672,675],{},[18,673,674],{},"Opret madhold"," øverst til højre",[409,677,678],{},"Vælg antal hold - de nye hold nummereres i forlængelse af de eksisterende",[409,680,417,681],{},[18,682,683],{},"Opret N madhold",[401,685,687],{"id":686},"sådan-redigerer-du-et-madhold","Sådan redigerer du et madhold",[406,689,690,693,699,702],{},[409,691,692],{},"Klik på holdets række i tabellen",[409,694,695,696,698],{},"Klik på ",[18,697,544],{}," (Rediger) i holdets hoved",[409,700,701],{},"Ret holdnavn, madlavningsdage eller medlemmer - alt gemmes med det samme",[409,703,417,704,707],{},[18,705,706],{},"Tilbage",", når du er færdig",[14,709,710],{},[461,711],{"alt":712,"src":713},"Ad