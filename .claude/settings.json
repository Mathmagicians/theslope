{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(npm list:*)",
      "Bash(npm run test:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx vitest:*)",
      "WebSearch",
      "WebFetch(domain:nuxt.com)",
      "WebFetch(domain:ui4.nuxt.com)",
      "WebFetch(domain:ui.nuxt.com)",
      "Bash(npx wrangler d1 execute=:* --remote=:* --command :*SELECT:*)",
      "Bash(npx wrangler queues --help)",
      "Bash(wrangler queues --help)",
      "Bash(npx wrangler queues list:*)",
      "Bash(wrangler queues list:*)",
      "Bash(npx wrangler queues info:*)",
      "Bash(wrangler queues info:*)"
    ],
    "deny": [
      "Read(./.cookies.txt)",
      "Read(./.env)",
      "Read(./.env.dev)",
      "Read(./.env.prod)",
      "Bash(npx wrangler :* --remote :*DELETE:*)",
      "Bash(npm run dev:*)",
      "Bash(git stash:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(npx wrangler queues create:*)",
      "Bash(wrangler queues create:*)",
      "Bash(npx wrangler queues update:*)",
      "Bash(wrangler queues update:*)",
      "Bash(npx wrangler queues delete:*)",
      "Bash(wrangler queues delete:*)",
      "Bash(npx wrangler queues purge:*)",
      "Bash(wrangler queues purge:*)",
      "Bash(npx wrangler queues pause-delivery:*)",
      "Bash(wrangler queues pause-delivery:*)",
      "Bash(npx wrangler queues resume-delivery:*)",
      "Bash(wrangler queues resume-delivery:*)",
      "Bash(npx wrangler queues consumer:*)",
      "Bash(wrangler queues consumer:*)",
      "Bash(npx wrangler queues subscription:*)",
      "Bash(wrangler queues subscription:*)",
      "Bash(npx wrangler email:*)",
      "Bash(wrangler email:*)",
      "Bash(make d1-migrate:*)",
      "Bash(make d1-copy:*)",
      "Bash(make d1-seed:*)",
      "Bash(make d1-time-travel-dev:*)",
      "Bash(make d1-time-travel-prod:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run db:seed:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(wrangler d1 migrations apply:*)",
      "Bash(npx wrangler d1 time-travel restore:*)",
      "Bash(wrangler d1 time-travel restore:*)",
      "Bash(npx wrangler d1 export:*)",
      "Bash(wrangler d1 export:*)"
    ],
    "ask": [
      "Bash(npx wrangler :* --remote :*)"
    ],
    "includeCoAuthoredBy": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-project-dir.sh"
          }
        ]
      }
    ]
  }
}
